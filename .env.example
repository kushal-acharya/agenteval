# Copy to .env and fill in. `.env` is gitignored; this template is not.
#
#   cp .env.example .env    # then paste your key into .env
#
# Only examples/fars_sql_agent.py needs a key. The harness core is
# model-independent and runs the toy agent with no credentials at all.

ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# AGENTEVAL_MODEL=claude-sonnet-5
